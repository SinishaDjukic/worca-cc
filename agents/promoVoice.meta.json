{
  "key": "promoVoice",
  "metaVersion": 2,
  "mockRole": "clarify",
  "promptHints": "Read the voices JSON. No voices: write {\"questions\":[]} to the answers path and stop (the video stays silent). Otherwise write {\"form\":\"promo-voice\",\"data\":{…}} built from its rows, in order, with each preview in its slot (preview1…preview6), and stop.",
  "inputs": [
    {
      "id": "voices",
      "type": "json",
      "as": "file"
    }
  ],
  "outputs": [
    {
      "id": "answers",
      "type": "json",
      "filename": "promo-voice.json",
      "artifactKind": "promo-voice"
    }
  ],
  "domain": "video",
  "displayName": "Promo: voice",
  "description": "Plays the ElevenLabs voices that match the setup (gender, narration use) and asks which one narrates. Asks nothing on a silent run or when no voice could be fetched.",
  "color": "red",
  "icon": "<rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M8.5 21h7\" stroke-linecap=\"round\"/>",
  "agentFile": "worca-cc-promo-voice.md",
  "runnerType": "clarifier",
  "asksQuestions": true,
  "questionsLocked": true,
  "questionsDefault": true,
  "order": 71,
  "ask": {
    "forms": {
      "promo-voice": {
        "version": 1,
        "title": "Pick the narrator’s voice",
        "data": {
          "type": "object",
          "required": [
            "voices"
          ],
          "properties": {
            "headline": {
              "type": "string",
              "maxLength": 240
            },
            "voices": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "gender": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "accent": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "about": {
                    "type": "string",
                    "maxLength": 480
                  },
                  "preview": {
                    "type": "file",
                    "accept": [
                      "audio/*"
                    ]
                  }
                }
              }
            },
            "defaultVoice": {
              "type": "string",
              "maxLength": 128
            },
            "preview1": {
              "type": "file",
              "accept": [
                "audio/*"
              ]
            },
            "preview2": {
              "type": "file",
              "accept": [
                "audio/*"
              ]
            },
            "preview3": {
              "type": "file",
              "accept": [
                "audio/*"
              ]
            },
            "preview4": {
              "type": "file",
              "accept": [
                "audio/*"
              ]
            },
            "preview5": {
              "type": "file",
              "accept": [
                "audio/*"
              ]
            },
            "preview6": {
              "type": "file",
              "accept": [
                "audio/*"
              ]
            }
          }
        },
        "answer": {
          "type": "object",
          "required": [
            "voiceId"
          ],
          "properties": {
            "voiceId": {
              "type": "string",
              "maxLength": 128,
              "enumFrom": "data.voices[].id",
              "defaultFrom": "data.defaultVoice"
            }
          }
        },
        "layout": [
          {
            "widget": "callout",
            "title": "Pick a voice",
            "bind": "data.headline",
            "tone": "info"
          },
          {
            "widget": "group",
            "title": "Listen",
            "children": [
              {
                "widget": "media",
                "bind": "data.preview1",
                "label": "Voice 1"
              },
              {
                "widget": "media",
                "bind": "data.preview2",
                "label": "Voice 2"
              },
              {
                "widget": "media",
                "bind": "data.preview3",
                "label": "Voice 3"
              },
              {
                "widget": "media",
                "bind": "data.preview4",
                "label": "Voice 4"
              },
              {
                "widget": "media",
                "bind": "data.preview5",
                "label": "Voice 5"
              },
              {
                "widget": "media",
                "bind": "data.preview6",
                "label": "Voice 6"
              }
            ]
          },
          {
            "widget": "select",
            "field": "voiceId",
            "label": "Voice",
            "style": "cards",
            "options": {
              "from": "data.voices",
              "value": "id",
              "label": "label",
              "description": "about"
            }
          }
        ],
        "example": {
          "headline": "2 female voices for narration. Play each one, then pick.",
          "voices": [
            {
              "id": "voice-a1",
              "name": "Ava",
              "label": "1 · Ava",
              "gender": "female",
              "accent": "american",
              "description": "warm, confident narrator",
              "about": "female · american — warm, confident narrator",
              "preview": "promo/voices/voice-a1.mp3"
            },
            {
              "id": "voice-b2",
              "name": "Bea",
              "label": "2 · Bea",
              "gender": "female",
              "accent": "british",
              "description": "bright and quick",
              "about": "female · british — bright and quick",
              "preview": "promo/voices/voice-b2.mp3"
            }
          ],
          "defaultVoice": "voice-a1",
          "preview1": "promo/voices/voice-a1.mp3",
          "preview2": "promo/voices/voice-b2.mp3"
        }
      }
    }
  }
}
