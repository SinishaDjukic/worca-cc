# A worca-railway target: ONE hosted worca deployment (docs/deploy-railway.md).
#
# Copy to ~/.config/worca/targets/<name>.env (chmod 600) and fill in. This file
# holds ids, hostnames and PATHS. Never put a secret value here: secrets live in
# the files the *_FILE entries point to, which the tool reads only to use them
# (request headers, stdin), never to print them.
#
#   node tools/railway/worca-railway.mjs status <name>

# Railway: `railway status --json` in a folder linked to the project, or the
# dashboard URLs (…/project/<project id>/service/<service id>?environmentId=<env id>).
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_WORCA_SERVICE=worca
RAILWAY_WORCA_SERVICE_ID=
RAILWAY_CLOUDFLARED_SERVICE=cloudflared

# The public hostname behind Cloudflare Access.
WORCA_URL=https://worca.example.com

# Images: released versions, and the repository `deploy-branch` pushes to
# (a registry you can push to, e.g. ghcr.io/<you>/worca-e2e).
IMAGE_REPO=ghcr.io/sinishadjukic/worca
BRANCH_IMAGE_REPO=

# A Cloudflare Access service token for `verify` (docs/remote-access.md, "Service
# tokens"): a 0600 file with two lines, CF_ACCESS_CLIENT_ID=… and
# CF_ACCESS_CLIENT_SECRET=…. Optional; without it `verify` skips the checks
# through Access.
ACCESS_SERVICE_TOKEN_FILE=~/.config/worca/secrets/example-access.env

# The private key registered with `railway ssh keys add`, for `ssh` and the
# in-container checks. Optional.
SSH_KEY=~/.ssh/id_ed25519
