{
  "name": "@worca/app",
  "version": "1.15.0-rc.1",
  "description": "Worca turns a task into reviewed, merge-ready work. A deterministic multi-agent pipeline that plans, implements and reviews in isolated git worktrees, with quality gates, budgets and a human in the loop. Web UI, CLI and chat.",
  "license": "MIT",
  "author": "Sinisha Djukic",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SinishaDjukic/worca-cc.git"
  },
  "homepage": "https://docs.worca.dev",
  "bugs": {
    "url": "https://github.com/SinishaDjukic/worca-cc/issues"
  },
  "keywords": [
    "worca",
    "ai-agents",
    "multi-agent",
    "orchestrator",
    "pipeline",
    "workflow",
    "autonomous-coding",
    "code-review",
    "git-worktree",
    "human-in-the-loop",
    "claude-code"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "worca": "src/cli/worca-cc.mjs"
  },
  "files": [
    "src/",
    "ui/server.mjs",
    "ui/public/",
    "extension/dist/chrome/",
    "extension/dist/edge/",
    "extension/dist/firefox/",
    "agents/",
    "skills/",
    "scripts/",
    "assets/deck-kit/",
    "assets/deck-narration/",
    "assets/deck-preview/",
    "assets/promo-kit/",
    "tools/install.mjs",
    "docker/compose*.yml",
    "docker/.env.example",
    "README.md"
  ],
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning ui/server.mjs",
    "stop": "node --disable-warning=ExperimentalWarning src/cli/worca-cc.mjs ui stop",
    "cli": "node --disable-warning=ExperimentalWarning src/cli/worca-cc.mjs",
    "install:agents": "node tools/install.mjs",
    "deck:sync": "node tools/deck-sync.mjs",
    "deck:vendor": "node tools/vendor-opendeck.mjs",
    "docs:publish": "node tools/docs-publish.mjs",
    "smoke": "WORCA_MOCK=1 WORCA_HOME=.worca-cc-smoke node --disable-warning=ExperimentalWarning src/cli/worca-cc.mjs --project sandbox --prompt \"demo task\" --mock --yes",
    "smoke:auto": "WORCA_MOCK=1 WORCA_HOME=.worca-cc-smoke node --disable-warning=ExperimentalWarning src/cli/worca-cc.mjs --project sandbox --prompt \"demo task\" --mock --yes --workflow auto",
    "smoke:workspace": "WORCA_MOCK=1 WORCA_HOME=.worca-cc-smoke node --disable-warning=ExperimentalWarning tools/smoke-workspace.mjs",
    "smoke:plugin": "WORCA_MOCK=1 WORCA_HOME=.worca-cc-smoke node --disable-warning=ExperimentalWarning tools/smoke-plugin.mjs",
    "docker:build": "node tools/docker-build.mjs",
    "docker:smoke": "node tools/docker-smoke.mjs",
    "ask:fixtures": "node --disable-warning=ExperimentalWarning tools/ask-capture-fixtures.mjs",
    "verify:composer": "node --disable-warning=ExperimentalWarning tools/verify-composer-cdp.mjs",
    "verify:run-monitor": "node --disable-warning=ExperimentalWarning tools/verify-run-monitor-cdp.mjs",
    "verify:theme": "node --disable-warning=ExperimentalWarning tools/verify-theme-cdp.mjs",
    "verify:memory": "node --disable-warning=ExperimentalWarning tools/verify-memory-cdp.mjs",
    "verify:scripts": "node --disable-warning=ExperimentalWarning tools/verify-scripts-cdp.mjs",
    "verify:ask-forms": "node --disable-warning=ExperimentalWarning tools/verify-ask-forms-cdp.mjs",
    "verify:workspace-map": "node --disable-warning=ExperimentalWarning tools/verify-workspace-map-cdp.mjs",
    "verify:flags": "node --disable-warning=ExperimentalWarning tools/verify-flags-cdp.mjs",
    "verify:feature-page": "node --disable-warning=ExperimentalWarning tools/verify-feature-page-cdp.mjs",
    "verify:runs-list": "node --disable-warning=ExperimentalWarning tools/verify-runs-list-cdp.mjs",
    "verify:requirements": "node --disable-warning=ExperimentalWarning tools/verify-requirements-cdp.mjs",
    "verify:chat-layout": "node --disable-warning=ExperimentalWarning tools/verify-chat-layout-cdp.mjs",
    "test": "node tools/test.mjs",
    "test:fast": "node tools/test.mjs --tier fast",
    "test:slow": "node tools/test.mjs --tier slow",
    "test:timings": "node tools/test.mjs --write-timings",
    "test:timings:merge": "node tools/test-timings-merge.mjs",
    "test:related": "node tools/test.mjs --related",
    "test:live": "node --disable-warning=ExperimentalWarning test/live/run.mjs",
    "ext:build": "node tools/build-extension.mjs",
    "ext:zip": "node tools/build-extension.mjs --zip",
    "ext:try": "node tools/try-extension.mjs",
    "demo:extension-video": "node tools/demo/extension-video/record.mjs",
    "prepack": "node tools/build-extension.mjs --pack",
    "ext:lint:firefox": "node tools/build-extension.mjs --browser firefox && web-ext lint --source-dir extension/dist/firefox",
    "e2e:extension": "node tools/build-extension.mjs --test --browser chrome && playwright test -c e2e/extension/playwright.config.mjs",
    "e2e:extension:update-linux": "docker run --rm --platform linux/amd64 -v worca-e2e-node-modules:/nm mcr.microsoft.com/playwright:v1.56.0-noble chown \"$(id -u):$(id -g)\" /nm && docker run --rm --platform linux/amd64 --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work -v worca-e2e-node-modules:/work/node_modules -w /work mcr.microsoft.com/playwright:v1.56.0-noble bash -lc \"npm ci && npm run e2e:extension -- --update-snapshots\"",
    "e2e:firefox-smoke": "node tools/build-extension.mjs --browser firefox && node tools/firefox-smoke.mjs"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@ricky0123/vad-web": "0.0.31",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "diff": "8.0.4",
    "dompurify": "3.4.17",
    "express": "^4.19.2",
    "gsap": "3.12.5",
    "htmlparser2": "12.0.0",
    "marked": "18.0.10",
    "onnxruntime-web": "1.22.0",
    "playwright-core": "1.56.0",
    "smol-toml": "1.9.0",
    "tar": "7.5.22",
    "undici": "7.30.0",
    "ws": "^8.18.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@playwright/test": "1.56.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "web-ext": "^10.8.0"
  },
  "overrides": {
    "addons-scanner-utils": {
      "express": "^4.19.2"
    }
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0",
    "node-pty": "1.1.0"
  }
}
