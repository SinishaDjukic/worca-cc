# docker/shared.env.example — the values an operator supplies for a shared instance (compose.shared.yml,
# docs/shared-instance.md). Copy it to shared.env next to the compose files and pass it with --env-file.
# No secret goes in this file: secrets are files under WORCA_SECRETS_DIR, owned by uid 1000, mode 0600.

# ── Host names ──────────────────────────────────────────────────────────────────────────────────────────
# The instance, and the key page on its own first-level host name (one certificate level on Cloudflare).
WORCA_INSTANCE_HOST=worca.acme.example
WORCA_KEYPAGE_HOST=worca-keys.acme.example

# ── The sign-in in front: Cloudflare Access (pick this or the identity header below) ──────────────────
# Worca's Access application, and the key page's own application (a different AUD).
WORCA_CF_ACCESS_TEAM_DOMAIN=acme.cloudflareaccess.com
WORCA_CF_ACCESS_AUD=
WORCA_BROKER_CF_ACCESS_TEAM_DOMAIN=acme.cloudflareaccess.com
WORCA_BROKER_CF_ACCESS_AUD=

# ── Or: an identity proxy of your own that verifies the person and sets a header ─────────────────────────
# Leave the four Access values above empty. The proxy needs a fixed address on the compose network, and that
# address must never be a range that includes Worca's container.
#WORCA_IDENTITY_HEADER=X-Forwarded-Email
#WORCA_IDENTITY_TRUSTED_PROXIES=172.30.0.10
#WORCA_INSECURE_NO_IDENTITY_CHECK=1
#WORCA_BROKER_IDENTITY_HEADER=X-Forwarded-Email
#WORCA_BROKER_IDENTITY_TRUSTED_PROXIES=172.30.0.10

# ── Secret files (paths; the files hold the values) ────────────────────────────────────────────────────
# The folder with broker_secret, egress_secret (each 32+ random characters: `worca broker secrets`),
# broker_vault_key (32 bytes, base64; keep a copy in the team's password manager) and tunnel_token.
# EVERY secret file, here and below: owned by uid 1000 (the containers' user), mode 0600.
#   sudo chown 1000:1000 secrets/* && sudo chmod 600 secrets/*
# Worca refuses to start while a file it reads (broker_secret, egress_secret, the GitHub App key) is readable by
# its group or others, or owned by another user: agents share its container under their own users.
WORCA_SECRETS_DIR=./secrets

# ── The corporate proxy, with a technical user's login ─────────────────────────────────────────────────
# Host and port only. The login is a file from `worca proxy hash` ({domain, user, ntHash}), never this URL.
# Leave both empty when there is no corporate proxy.
HTTPS_PROXY=http://proxy.acme.example:8080
NO_PROXY=127.0.0.1,localhost
WORCA_PROXY_LOGIN=./secrets/proxy_login.json

# ── The allow-list: what Worca and the broker may reach through the sidecar ──────────────────────────────
# api.anthropic.com for the broker, your git host, your package registries. ".acme.example" allows subdomains.
WORCA_EGRESS_ALLOW=api.anthropic.com,github.com,.github.com,.githubusercontent.com,registry.npmjs.org

# ── GitHub ─────────────────────────────────────────────────────────────────────────────────────────────
# Pushes and pull requests as the person who acted: required (or prefer). Each person saves a token on the key page.
WORCA_GH_AS_PERSON=required
# Optional "Sign in with GitHub" on the key page: the app's client ID, and its client secret as a file.
#WORCA_BROKER_GITHUB_CLIENT_ID=Iv23li...
#WORCA_BROKER_GITHUB_CLIENT_SECRET_PATH=./secrets/github_client_secret
# Optional: the deployment's own GitHub App for reads everyone sees (pull request status, checks).
#WORCA_GH_APP_ID=123456
#WORCA_GH_APP_KEY=./secrets/github_app_key.pem

# ── Budgets per person and per slot, in USD (optional) ─────────────────────────────────────────────────
#WORCA_BROKER_DEFAULT_DAILY_USD=50
#WORCA_BROKER_DEFAULT_MONTHLY_USD=500

# ── Everything else from compose.yml applies as usual ──────────────────────────────────────────────────
TZ=Europe/Berlin
#WORCA_TAG=1.21.0
#CLOUDFLARED_TAG=2026.10.3
