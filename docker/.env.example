# docker/.env.example — copy to .env next to compose.yml. Every line is optional.
# chmod 600 .env if it holds a token.

# The folder that holds your repositories (mounted at the same path inside;
# see docs/docker.md for the Windows/WSL2 and /projects notes).
WORCA_PROJECTS=/Users/me/dev
# Mount it somewhere else inside the container (loses path parity):
#WORCA_PROJECTS_MOUNT=/projects

# Image tag: latest | rc | 1.3.0 | 1.3.0-full | dev
#WORCA_TAG=latest

# Host port the UI is published on (loopback only).
#WORCA_PORT=4317

# Scheduled runs use wall-clock time in this zone.
TZ=Europe/Berlin

# Git identity for the commits agents make in run worktrees.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# GitHub over HTTPS: PRs, GitHub Issues source, team metrics/policy branches, clone-in.
#GH_TOKEN=github_pat_...

# Claude Code auth. Prefer none of these and `docker compose run --rm worca claude`
# to log in once into the volume. Otherwise ONE of:
#CLAUDE_CODE_OAUTH_TOKEN=...      # from `claude setup-token` on a logged-in machine
#ANTHROPIC_API_KEY=sk-ant-...     # Console key (visible to every child process)
# API key as a compose secret instead (never in the environment):
#   put the key in ./anthropic_api_key, then add to a compose.override.yml:
#     services: { worca: { secrets: [anthropic_api_key] } }
#     secrets: { anthropic_api_key: { file: ./anthropic_api_key } }

# Linux Engine only: your uid/gid when not 1000 (`id -u`, `id -g`).
#WORCA_UID=1000
#WORCA_GID=1000

# Resource caps.
#WORCA_MEM=6g
#WORCA_CPUS=4

# Corporate proxy / TLS interception.
#HTTPS_PROXY=http://proxy.corp:3128
#NO_PROXY=127.0.0.1,localhost

# Egress overlay (compose.egress.yml): allowlist, ".host" allows subdomains.
#WORCA_EGRESS_ALLOW=api.anthropic.com,github.com,.github.com,.githubusercontent.com,registry.npmjs.org

# SSH overlay (compose.ssh.yml), Linux Engine / Podman only.
#WORCA_SSH_SOCK=/run/user/1000/keyring/ssh

# Teams overlay (compose.teams.yml).
#CLOUDFLARE_TUNNEL_TOKEN=...
