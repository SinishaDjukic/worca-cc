# docker/.env.example — copy to .env next to compose.yml. Every line is optional.
# chmod 600 .env if it holds a token.

# The folder that holds your repositories (mounted at the same path inside;
# see docs/docker.md for the Windows/WSL2 and /projects notes).
WORCA_PROJECTS=/Users/me/dev
# Mount it somewhere else inside the container (loses path parity):
#WORCA_PROJECTS_MOUNT=/projects

# Image tag: latest | rc | 1.3.0 | 1.3.0-full | dev
#WORCA_TAG=latest

# The box image built from your projects' environment specs (`worca container build`;
# docs/environment-spec.md). The base it starts from: a Worca image, or one built FROM it.
# Set here only, never in a project. Default: the image of WORCA_TAG above.
#WORCA_BASE_IMAGE=registry.acme.example/platform/worca:1.21.0
# `worca container build` writes this line; the box then runs that local image
# (compose.image.yml). `worca container build --reset` removes it.
#WORCA_IMAGE=worca-box:0123456789ab

# Host port the UI is published on (loopback only).
#WORCA_PORT=4317

# Scheduled runs use wall-clock time in this zone.
TZ=Europe/Berlin

# Git identity for the commits agents make in run worktrees.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# GitHub over HTTPS: PRs, GitHub Issues source, team metrics/policy branches, clone-in.
#GH_TOKEN=github_pat_...

# Claude Code auth. Prefer none of these and `docker compose run --rm worca claude`
# to log in once into the volume. Otherwise ONE of:
#CLAUDE_CODE_OAUTH_TOKEN=...      # from `claude setup-token` on a logged-in machine
#ANTHROPIC_API_KEY=sk-ant-...     # Console key (visible to every child process)
# API key as a compose secret instead (never in the environment):
#   put the key in ./anthropic_api_key, then add to a compose.override.yml:
#     services: { worca: { secrets: [anthropic_api_key] } }
#     secrets: { anthropic_api_key: { file: ./anthropic_api_key } }

# Linux Engine only: your uid/gid when not 1000 (`id -u`, `id -g`).
#WORCA_UID=1000
#WORCA_GID=1000

# Resource caps.
#WORCA_MEM=6g
#WORCA_CPUS=4

# Corporate proxy / TLS interception.
#HTTPS_PROXY=http://proxy.corp:3128
#NO_PROXY=127.0.0.1,localhost
# Never a 127.0.0.1 proxy: inside the box that is the box itself. `worca container`
# leaves out the local proxy a Worca terminal sets and uses settings.json
# networkProxy.upstream when it needs no login (docs/docker.md).
# A proxy that needs a login: the login lives in the egress sidecar (compose.proxy.yml),
# never in the box. A Basic or Digest login in the URL above goes to the sidecar only:
#HTTPS_PROXY=http://ACME%5Cjdoe:password@proxy.acme.example:8080
# For NTLMv2, leave the URL without a login and run `worca container proxy login`.
# The sidecar's shared secret; `worca container` writes it for you:
#WORCA_EGRESS_SECRET=
# The broker's calls to the model providers through the sidecar (compose.broker.yml;
# `worca container` sets it whenever the sidecar runs):
#WORCA_BROKER_PROXY=http://egress:3128
# A proxy that re-signs TLS: its CA as a PEM file on this machine. `worca container`
# then adds compose.ca.yml (raw compose: -f compose.ca.yml) to mount and trust it.
#WORCA_CA_CERT=/Users/me/certs/corporate-ca.pem

# Egress overlay (compose.egress.yml): allowlist, ".host" allows subdomains and host itself.
#WORCA_EGRESS_ALLOW=api.anthropic.com,github.com,.github.com,.githubusercontent.com,registry.npmjs.org

# SSH overlay (compose.ssh.yml), Linux Engine / Podman only.
#WORCA_SSH_SOCK=/run/user/1000/keyring/ssh

# Teams overlay (compose.teams.yml).
#CLOUDFLARE_TUNNEL_TOKEN=...

# Hardened box (compose.hardened.yml; docs/hardened-box.md). `worca container up --hardened`
# writes these for you and never overwrites a value set here:
#WORCA_BROKER_KEY_ANTHROPIC=sk-ant-...   # the model credential, held by the broker only
#WORCA_BROKER_SECRET=                    # generated
#WORCA_EGRESS_SECRET=                    # generated (also above)
#WORCA_EGRESS_ALLOW=api.anthropic.com,github.com,.github.com,.githubusercontent.com,registry.npmjs.org
# The git token (GH_TOKEN, WORCA_ADO_TOKEN or WORCA_BB_TOKEN), GIT_AUTHOR_*, HTTPS_PROXY
# (host and port only: the login goes to the sidecar) and WORCA_CA_CERT are the ones above.
