# docker/engines.env — the engine CLI versions the worker image pins (docker/engines/install.sh).
# KEY=value, one per line; `#` lines and blank lines are ignored. tools/docker-build.mjs passes
# every key as a `--build-arg`, and so does .github/workflows/docker-image.yml. Claude Code's pin
# lives in docker/CLAUDE_CODE_VERSION (one file, bumped by PR), not here.
#
# Floors (docs/models.md, "Chat on X needs …"): codex 0.162, copilot 1.0.100, gemini 0.65.0,
# qwen 0.26.1, goose 1.56.0, opencode 1.19.4. OpenCode stays on 1.x: worca refuses OpenCode 2
# (npm @opencode/cli) until it is supported.

# npm @openai/codex
CODEX_VERSION=0.167.0
# npm @google/gemini-cli
GEMINI_CLI_VERSION=0.67.0
# npm @qwen-code/qwen-code
QWEN_CODE_VERSION=0.26.9
# npm @github/copilot (1.0.100 or newer for Chat)
COPILOT_CLI_VERSION=1.0.107
# npm opencode-ai (1.x only)
OPENCODE_VERSION=1.19.5

# Goose: the GitHub release tarball goose-<arch>-unknown-linux-gnu.tar.bz2 of
# https://github.com/aaif-goose/goose/releases/tag/v<GOOSE_VERSION> (the former block/goose).
# The checksums are of the tarballs themselves; when a bump leaves a sha empty, install.sh skips
# the check for that architecture with a loud warning. Both verified for 1.57.0 on 2026-11-07.
GOOSE_VERSION=1.57.0
GOOSE_SHA256_AMD64=e54036f3b7f95d3b0d7854c09465af5ef52a28c7fa03d2497d0ea68a6382282d
GOOSE_SHA256_ARM64=17c6b090db6acc5605da904bbe19cc2765bc7a6786019d85a6d0a361de06dbf7

# Cursor: https://cursor.com/install picks the build itself and has no version switch, so this
# pin is informational (what the script shipped when it was last checked); empty means "whatever
# the script installs today". The build still records what it got (`cursor-agent --version`).
CURSOR_AGENT_VERSION=2026.11.05-86047df

# -full only (the `os` stage): npm @railway/cli, and uv from PyPI.
RAILWAY_CLI_VERSION=5.71.0
UV_VERSION=0.13.7
