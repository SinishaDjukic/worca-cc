{
  "key": "c4Check",
  "metaVersion": 2,
  "displayName": "C4: check",
  "description": "Parses the C4 file the architect wrote, resolves every view, and fails the step with a precise report when the file does not parse, references unknown elements, leaves a band empty, or places an element outside the band whose criteria name it. Deterministic, no model call.",
  "domain": "architecture",
  "color": "teal",
  "icon": "<path d=\"M5 12.5l4.5 4.5L19 7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
  "order": 61,
  "runtime": "node",
  "file": "c4-check.mjs",
  "inputs": [
    {
      "id": "model",
      "type": "json"
    }
  ],
  "outputs": [
    {
      "id": "review",
      "type": "md",
      "when": "blocking",
      "filename": "c4-check-cycle{cycle}.md",
      "artifactKind": "c4-check"
    },
    {
      "id": "pass",
      "type": "void",
      "when": "clean"
    },
    {
      "id": "checked",
      "type": "json",
      "when": "clean",
      "filename": "c4-checked.json",
      "artifactKind": "c4-check"
    }
  ],
  "verdict": {
    "filename": "c4-check-cycle{cycle}.json"
  }
}
